{
  "manifest_version": 3,
  "name": "Autofill Extension",
  "version": "1.0",
  "description": "Расширение для автоматического заполнения форм",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
  "service_worker": "background.js"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>", "http://localhost:*/*"],
      "js": ["executor.js","content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>", "http://localhost:*/*"]
    }
  ]
}